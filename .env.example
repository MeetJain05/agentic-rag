# LLM
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
# Router/graders use a deterministic model
GRADER_TEMPERATURE=0
LLM_MAX_RETRIES=2

# Web Search
TAVILY_API_KEY=

# LangSmith
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=Agentic-Adaptive-RAG
LANGSMITH_API_KEY=

# RAG
PINECONE_API_KEY=
PINECONE_INDEX_NAME=agentic-adaptive-rag-integrated
PINECONE_NAMESPACE=default
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_K=4
# Retrieval: dense + keyword (hybrid), fused, then reranked to RETRIEVAL_K
PINECONE_RERANK_MODEL=bge-reranker-v2-m3
RETRIEVAL_CANDIDATES=12
HYBRID_SEARCH=true
PINECONE_EMBED_MODEL=multilingual-e5-large
# Widen each relevant chunk with N neighbours on each side (0 = off)
NEIGHBOR_CHUNKS=1

# Local state (registry, keyword index, SQLite checkpoints).
# Rebuilt from Pinecone automatically if the disk is wiped.
DATA_DIR=./data

# Durable HITL approvals across restarts/redeploys (needed on hosts
# with ephemeral disks such as Render free tier). Postgres URL, e.g. Neon.
CHECKPOINT_DATABASE_URL=

# API
FRONTEND_URL=http://localhost:3000
MAX_UPLOAD_SIZE_MB=10